# CareThread MVP Environment Configuration Template
# Copy to `.env` for local live-GCP runs (`.env` is git-ignored).
#
# Security rules:
# - ZERO hardcoded API keys or credentials.
# - Google Cloud APIs authenticate via ADC (`gcloud auth application-default login` locally,
#   or dedicated least-privilege Cloud Run service accounts in GCP).
# - Signing secrets live in GCP Secret Manager (populate versions out-of-band).

# Google Cloud / Vertex AI (ADC)
GOOGLE_CLOUD_PROJECT=your-sandbox-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# CareThread Core Runtime
CARETHREAD_PROJECT_ID=your-sandbox-gcp-project-id
CARETHREAD_REGION=us-central1
CARETHREAD_ENABLE_ARGON_REVIEWER=false

# Protected Data Stores (populate from `terraform output` after provisioning)
CARETHREAD_FHIR_STORE_ID=projects/your-sandbox-gcp-project-id/locations/us-central1/datasets/carethread-ds/fhirStores/carethread-fhir-r4
CARETHREAD_SPANNER_INSTANCE=carethread-graph-dev
CARETHREAD_SPANNER_DATABASE=carethread-continuity
CARETHREAD_FIRESTORE_DB=carethread-ops-dev
CARETHREAD_RAW_AUDIO_BUCKET=carethread-raw-audio-your-sandbox-gcp-project-id-dev
CARETHREAD_TRANSCRIPTS_BUCKET=carethread-transcripts-your-sandbox-gcp-project-id-dev
CARETHREAD_PACKETS_BUCKET=carethread-packets-your-sandbox-gcp-project-id-dev
CARETHREAD_SDP_TEMPLATE=projects/your-sandbox-gcp-project-id/locations/us-central1/deidentifyTemplates/your-template-id

# Secret Manager Secret IDs (values resolved from Secret Manager at runtime)
CARETHREAD_CAPABILITY_SECRET_ID=carethread-capability-hmac-dev
CARETHREAD_SIGNING_SECRET_ID=carethread-signing-key-dev
